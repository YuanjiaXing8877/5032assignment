rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdministrator() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdministrator();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'Volunteer'
        && request.resource.data.email == request.auth.token.email;

      allow update: if isAdministrator()
        || (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email);

      allow delete: if isAdministrator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
